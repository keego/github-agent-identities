{
  "name": "github-agent-identities",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conversation-bound GitHub App identities for MCP clients",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev:local": "tsx src/local.ts",
    "check": "npm run typecheck && npm test",
    "test:d1": "tsx --test tests/d1-integration.test.ts",
    "cf:build": "cf build --mode staging",
    "cf:build:dry-run": "cf deploy --mode staging --dry-run",
    "qa:local": "npm run check && npm run cf:build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@octokit/auth-app": "^8.3.1",
    "@modelcontextprotocol/node": "2.1.2",
    "zod": "^4.1.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@modelcontextprotocol/client": "2.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "cf": "1.0.0-rc.1",
    "miniflare": "4.20260730.0",
    "wrangler": "^4.164.0"
  }
}
